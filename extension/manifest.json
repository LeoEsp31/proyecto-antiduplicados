{
  "manifest_version": 3,
  "name": "Detector de Descargas",
  "version": "1.1",
  "description": "Intercepta descargas para verificar duplicados locales.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "notifications"
  ],
  "icons": {
    "16": "icono.png",
    "48": "icono.png",
    "128": "icono.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}